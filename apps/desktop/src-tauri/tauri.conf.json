{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VALORANT Analytics Coach",
  "version": "0.1.0",
  "identifier": "com.fivesunfw.valorantanalytics",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev --workspace=@valorant/desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build --workspace=@valorant/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VALORANT Analytics Coach",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
