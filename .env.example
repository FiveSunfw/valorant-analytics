RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_REDIRECT_URI=http://localhost:8000/auth/riot/callback
# Supplied by Riot when RSO is approved. Do not guess or use unofficial endpoints.
RIOT_RSO_AUTHORIZE_URL=
RIOT_RSO_TOKEN_URL=
RIOT_RSO_USERINFO_URL=
RIOT_RSO_SCOPES=openid offline_access
RIOT_ACCOUNT_REGION=asia
RIOT_POST_AUTH_REDIRECT_URL=http://localhost:3001/?riot=connected
# Server-side Riot Developer/Production API key. Never expose this to the web app.
RIOT_API_KEY=
# VAL platform routing value for the authorized account, for example ap, na, or eu.
RIOT_PLATFORM=ap
# Base64-encoded 32-byte AES key used only by the server to encrypt RSO tokens.
# Generate a unique value per environment; never commit the real value.
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=postgresql://valorant:valorant_dev@localhost:15432/valorant
REDIS_URL=redis://localhost:16379/0
RABBITMQ_URL=amqp://localhost:5672
# Optional OpenAI-compatible model endpoint for the analysis Agent. Keep the
# real key in the local process environment or an ignored .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
# Hybrid RAG. Production uses Qdrant Cloud; local development may use http://127.0.0.1:6333.
# These are server-only secrets. Do not add them to NEXT_PUBLIC_* variables.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=valorant_knowledge_v1
QDRANT_TIMEOUT_MS=8000
JINA_TIMEOUT_MS=30000
JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
KNOWLEDGE_INDEX_VERSION=v1
LOCAL_EMBEDDING_URL=http://127.0.0.1:18090
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
ENABLE_KNOWLEDGE_RERANK=true
KNOWLEDGE_INGESTION_ROOT=E:\\valorant-video-ingestion
# Disabled by default. Only enable locally after running the fixture seed.
ENABLE_DEMO_MODE=false
ENABLE_EVAL_MODE=false
# Server-side URL used by Next.js route handlers. It is not exposed to browsers.
API_BASE_URL=http://127.0.0.1:8000
